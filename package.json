{
  "name": "@cityssm/faster-web-helper",
  "version": "1.0.0-alpha.4",
  "private": true,
  "description": "A service to support integrations with FASTER Web.",
  "keywords": [
    "faster-web",
    "worktech",
    "inventory-management"
  ],
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "coverage": "c8 --reporter=lcov --reporter=text --reporter=text-summary node --env-file=.dev.env --test \"./test/*.test.js\"",
    "cy:open": "cypress open --config-file cypress.config.ts",
    "cy:run": "cypress run --config-file cypress.config.ts",
    "dev": "nodemon --env-file=.dev.env ./index.js",
    "healthCheck": "node --env-file=.dev.env ./scripts/healthCheck.js",
    "start": "node ./index.js",
    "start:debug": "node --env-file=.dev.env ./index.js",
    "task:inventoryScanner:syncScannerRecords": "node --env-file=.dev.env ./modules/inventoryScanner/tasks/onDemand/syncScannerRecords.onDemand.js",
    "test": "node --env-file=.dev.env --test \"./test/*.test.js\""
  },
  "allowScripts": {
    "better-sqlite3": true,
    "registry-js": true,
    "win-version-info": true,
    "cypress": true,
    "puppeteer": true
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "16.2.0"
    }
  },
  "dependencies": {
    "@cityssm/authentication-helper": "^1.0.0",
    "@cityssm/bulma-js": "^1.0.0-rc.4",
    "@cityssm/bulma-webapp-js": "^1.5.0",
    "@cityssm/configurator": "^0.2.0",
    "@cityssm/dynamics-gp": "^1.7.1",
    "@cityssm/faster-constants": "^0.3.1",
    "@cityssm/faster-report-exporter": "^1.0.0",
    "@cityssm/faster-report-parser": "^1.0.1",
    "@cityssm/faster-unofficial-api": "^1.0.0",
    "@cityssm/faster-url-builder": "^1.1.0",
    "@cityssm/has-package": "^1.0.0",
    "@cityssm/is-private-network-address": "^1.0.0",
    "@cityssm/is-sault-ste-marie": "^1.0.0",
    "@cityssm/mssql-multi-pool": "^5.2.0",
    "@cityssm/ntfy-publish": "^1.1.1",
    "@cityssm/scheduled-task": "^0.3.0",
    "@cityssm/to-millis": "^1.0.1",
    "@cityssm/utils-datetime": "^1.4.1",
    "@cityssm/worktech-api": "^0.18.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@shaggytools/nhtsa-api-wrapper": "^3.0.4",
    "basic-ftp": "^6.2.3",
    "better-sqlite3": "^13.0.3",
    "bulma": "^1.0.4",
    "camelcase": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "country-and-province": "^2.0.0",
    "debug": "^4.4.3",
    "ejs": "^7.0.1",
    "exit-hook": "^5.1.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "jsbarcode": "^3.12.3",
    "papaparse": "^5.7.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/node-schedule": "^2.1.8",
    "@types/node-windows": "^0.1.6",
    "@types/papaparse": "^5.5.2",
    "@types/session-file-store": "^1.2.6",
    "cypress": "^16.2.0",
    "cypress-axe": "^1.7.0",
    "eslint-config-cityssm": "^58.0.0",
    "nodemon": "^3.1.14",
    "prettier-config-cityssm": "^2.2.0"
  },
  "optionalDependencies": {
    "@cityssm/faster-api": "github:cityssm/node-faster-api#v1.5.0",
    "@cityssm/sectorflow": "^0.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
